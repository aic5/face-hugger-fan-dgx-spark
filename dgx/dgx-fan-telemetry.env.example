# Install as /etc/dgx-fan-telemetry.env with mode 600.
DGX_FAN_PICO_URL=http://192.168.2.77
DGX_FAN_USERNAME=
DGX_FAN_PASSWORD=
DGX_FAN_INTERVAL_SECONDS=5
DGX_FAN_AUTOMATIC_DEFAULT=1

# Optional: pin CPU collection to a zone after running --probe.
# DGX_FAN_CPU_ZONE=/sys/class/thermal/thermal_zone0

# Optional: replace the default nvidia-smi query without invoking a shell.
# DGX_FAN_GPU_COMMAND=nvidia-smi --query-gpu=temperature.gpu --format=csv,noheader,nounits
